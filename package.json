{
  "name": "html-llm-interfacer",
  "version": "0.0.1",
  "description": "Web Automation Library with LLM Integration - Based on research of 13 production frameworks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist/",
    "prebuild": "npm run clean",
    "pretest": "npm run build"
  },
  "keywords": [
    "web-automation",
    "llm",
    "browser",
    "typescript",
    "puppeteer",
    "DOM",
    "element-detection",
    "action-execution"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "puppeteer": "^21.0.0",
    "zod": "3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/html-llm-interfacer.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/html-llm-interfacer/issues"
  }
}
